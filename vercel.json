{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "buildCommand": "./scripts/vercel-build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "packages/intelligence/src/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py?__path=/api/$1" },
    { "source": "/health", "destination": "/api/index.py?__path=/health" },
    { "source": "/ready", "destination": "/api/index.py?__path=/ready" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
