{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "buildCommand": "./scripts/vercel-build.sh",
  "outputDirectory": "apps/frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "packages/intelligence/src/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py?__path=/api/$1" },
    { "src": "/health", "dest": "/api/index.py?__path=/health" },
    { "src": "/ready", "dest": "/api/index.py?__path=/ready" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
