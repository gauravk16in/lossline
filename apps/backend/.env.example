# Environment configuration
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<strong-database-password>
DATABASE_URL=<postgresql-async-runtime-url>
DIRECT_DATABASE_URL=<postgresql-direct-migration-url>

# Redis Configuration (Local Redis by default)
REDIS_URL=redis://localhost:6379/0

# Required protected-demo credentials. Use independent random values.
INGEST_API_KEY=<random-ingest-key>
MANAGER_API_KEY=<random-manager-key>
ADMIN_API_KEY=<random-admin-key>
CORS_ORIGINS=http://localhost:3000
WS_ALLOWED_ORIGINS=http://localhost:3000
ALLOW_GLOBAL_DEMO_RESET=false

# (Optional) External APIs
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=8
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
