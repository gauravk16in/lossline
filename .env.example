DATABASE_URL=postgresql+asyncpg://lossline:lossline_demo@localhost:5432/lossline
DIRECT_DATABASE_URL=postgresql://lossline:lossline_demo@localhost:5432/lossline
REDIS_URL=redis://localhost:6379/0
DEMO_MODE=true
DEBUG=false
INLINE_PROCESSING=false
CONFIG_VERSION=config.v1
RECOMMENDATION_EXPIRY_MINUTES=15
OUTCOME_MIN_EVENTS=3
STREAM_MAX_RETRIES=3

# Vercel production (set as encrypted environment variables, not in files)
SERVERLESS_MODE=false
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=
CREDENTIAL_PEPPER=
EVENT_RATE_LIMIT=300
READ_RATE_LIMIT=120
WRITE_RATE_LIMIT=30
ADMIN_RATE_LIMIT=20
# The browser may receive only VITE_CLERK_PUBLISHABLE_KEY; API calls are same-origin.
VITE_CLERK_PUBLISHABLE_KEY=
