# Environment configuration
ENVIRONMENT=development
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# NeonDB PostgreSQL configurations
# DATABASE_URL is for application runtime (should use Neon transaction pooler)
DATABASE_URL=postgresql+asyncpg://user:password@ep-pooler-id.region.aws.neon.tech/dbname?sslmode=require
# DIRECT_DATABASE_URL is for migrations (must use Neon direct connection, bypassing PgBouncer)
DIRECT_DATABASE_URL=postgresql://user:password@ep-direct-id.region.aws.neon.tech/dbname?sslmode=require

# Redis Configuration (Local Redis by default)
REDIS_URL=redis://localhost:6379/0

# (Optional) External APIs
LLM_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
